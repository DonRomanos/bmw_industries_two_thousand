{
  "name": "BMW Industries Two Thousand (BITT)",
  // Host networking (see docker-compose.yml) works on Linux and on Windows/WSL2 with Docker running inside WSL;
  // Docker Desktop is not supported.
  // The host GPU (NVIDIA, AMD, Intel, WSL2) is detected on every start and written to gpu.generated.yml.
  "dockerComposeFile": ["docker-compose.yml", "gpu.generated.yml"],
  "service": "student",
  "workspaceFolder": "/workspaces/bmw_industries_two_thousand",
  "initializeCommand": "bash .devcontainer/detect_gpu.sh",
  "containerEnv": {
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}",
    "ROS_STATIC_PEERS": "${localEnv:BITT_IP:10.42.0.1}",
    "BITT_IP": "${localEnv:BITT_IP:10.42.0.1}",
    "BITT_STUDENT_WS": "${containerWorkspaceFolder}/student_ws",
    "DISPLAY": "${localEnv:DISPLAY:0}",
    "QT_QPA_PLATFORM": "xcb",
    "QT_X11_NO_MITSHM": "1"
  },
  "remoteUser": "ubuntu",
  "postCreateCommand": "mkdir -p student_ws/src && bash -c 'source /opt/ros/lyrical/setup.bash && source /opt/bitt_ws/install/setup.bash && cd student_ws && colcon build'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": [
          "/opt/ros/lyrical/lib/python3.14/site-packages",
          "/opt/bitt_ws/install/car_interfaces/lib/python3.14/site-packages"
        ]
      }
    }
  }
}
