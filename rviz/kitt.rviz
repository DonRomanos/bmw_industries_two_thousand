Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/RobotModel
      Name: Car
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.7
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 0; 200; 0
    - Class: rviz_default_plugins/Path
      Name: SLAM path
      Enabled: true
      Topic:
        Value: /visual_slam/tracking/slam_path
        Reliability Policy: Reliable
      Color: 255; 255; 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /visual_slam/tracking/odometry
        Depth: 5
        Reliability Policy: Reliable
      Keep: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: nvblox ESDF slice
      Enabled: false
      Topic:
        Value: /nvblox_node/static_esdf_pointcloud
        Depth: 1
        Reliability Policy: Reliable
      Color Transformer: Intensity
      Channel Name: intensity
      Style: Boxes
      Size (m): 0.05
    - Class: rviz_default_plugins/Map
      Name: nvblox occupancy grid
      Enabled: false
      Topic:
        Value: /nvblox_node/static_occupancy_grid
      Alpha: 0.6
    - Class: rviz_default_plugins/Image
      Name: Left camera (preview)
      Enabled: true
      Topic:
        Value: /preview/left
        Depth: 1
        Reliability Policy: Best Effort
        Transport Hint: compressed
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Scale: 40
      Angle: 0
      X: 0
      Y: 0
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Window Geometry:
  Displays:
    collapsed: false
  Time:
    collapsed: false
  Height: 900
  Width: 1400
  Hide Left Dock: false
  Hide Right Dock: true
