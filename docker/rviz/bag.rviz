Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_common/Group
      Name: Cameras
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Image
          Name: Left camera
          Enabled: true
          Topic:
            Value: /visual_slam/image_0
            Depth: 1
            Reliability Policy: Best Effort
        - Class: rviz_default_plugins/Image
          Name: Right camera
          Enabled: true
          Topic:
            Value: /visual_slam/image_1
            Depth: 1
            Reliability Policy: Best Effort
        - Class: rviz_default_plugins/Image
          Name: Feature tracks (OpenCV)
          Enabled: true
          Topic:
            Value: /replay/features
            Depth: 1
            Reliability Policy: Best Effort
        - Class: rviz_default_plugins/Image
          Name: Dashboard
          Enabled: true
          Topic:
            Value: /replay/dashboard
            Depth: 1
            Reliability Policy: Best Effort
    - Class: rviz_common/Group
      Name: Robot
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Grid
          Name: Grid
          Enabled: true
        - Class: rviz_default_plugins/TF
          Name: TF
          Enabled: true
        - Class: rviz_default_plugins/RobotModel
          Name: Robot model
          Enabled: true
          Description Topic:
            Value: /robot_description
            Durability Policy: Transient Local
            Reliability Policy: Reliable
        - Class: rviz_default_plugins/Odometry
          Name: Robot (odometry)
          Enabled: true
          Topic:
            Value: /visual_slam/tracking/odometry
            Depth: 5
            Reliability Policy: Reliable
          Keep: 1
          Shape:
            Value: Axes
            Axes Length: 0.3
            Axes Radius: 0.03
    - Class: rviz_common/Group
      Name: Trajectory
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Path
          Name: Recorded path
          Enabled: true
          Topic:
            Value: /replay/path
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Color: 255; 170; 0
          Line Style: Billboards
          Line Width: 0.03
        - Class: rviz_default_plugins/Path
          Name: cuVSLAM SLAM path (recorded)
          Enabled: true
          Topic:
            Value: /visual_slam/tracking/slam_path
            Reliability Policy: Best Effort
          Color: 0; 170; 255
          Line Style: Billboards
          Line Width: 0.03
    - Class: rviz_common/Group
      Name: Map
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/PointCloud2
          Name: Reconstructed cloud (from stereo images, old bags)
          Enabled: true
          Topic:
            Value: /replay/cloud
            Depth: 1
            Durability Policy: Transient Local
            Reliability Policy: Reliable
          Style: Points
          Size (Pixels): 2
          Color Transformer: RGB8
        - Class: rviz_default_plugins/PointCloud2
          Name: nvblox ESDF slice (recorded)
          Enabled: true
          Topic:
            Value: /nvblox_node/static_esdf_pointcloud
            Depth: 1
            Reliability Policy: Best Effort
          Color Transformer: Intensity
          Channel Name: intensity
          Style: Boxes
          Size (m): 0.05
        - Class: rviz_default_plugins/Map
          Name: nvblox occupancy grid (recorded)
          Enabled: true
          Topic:
            Value: /nvblox_node/static_occupancy_grid
            Reliability Policy: Best Effort
          Alpha: 0.6
        - Class: rviz_default_plugins/Marker
          Name: nvblox mesh (recorded, record_bag.sh --mesh)
          Enabled: true
          Topic:
            Value: /nvblox_node/mesh_marker
            Reliability Policy: Best Effort
        - Class: rviz_default_plugins/PointCloud2
          Name: cuVSLAM landmarks (recorded, newer bags)
          Enabled: true
          Topic:
            Value: /visual_slam/vis/landmarks_cloud
            Depth: 1
            Reliability Policy: Best Effort
          Style: Points
          Size (Pixels): 3
          Color Transformer: FlatColor
          Color: 255; 255; 0
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 25
      Pitch: 1.2
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Time
    Name: Time
Window Geometry:
  Displays:
    collapsed: false
  Time:
    collapsed: false
  Height: 1000
  Width: 1700
  Hide Left Dock: false
  Hide Right Dock: true
