# RViz2 + rosbag2 (MCAP) for replaying recorded bags on the dev host. Build and run with
# scripts/view_bag.sh.
#
# Based on the official ROS image: Lyrical's desktop packages (rviz2, rclpy, rosbag2) are only
# published for Ubuntu 26.04 (resolute), not noble, so the main Dockerfile in this directory
# cannot provide them. Bags only need the standard message types, so no Isaac packages are needed.

ARG BASE_IMAGE=ros:lyrical-ros-base
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-lyrical-rviz2 \
        ros-lyrical-rosbag2-py \
        ros-lyrical-rosbag2-storage-mcap \
        python3-numpy python3-opencv \
        mesa-utils libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

COPY bag.rviz /config/bag.rviz
COPY odom_to_path.py bag_to_cloud.py replay.sh /opt/replay/
