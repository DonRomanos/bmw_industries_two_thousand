<?xml version="1.0"?>
<package format="3">
  <name>kitt_sim</name>
  <version>0.1.0</version>
  <description>Gazebo simulation of the BMW i8 ride-on with the real car's Nav2 configuration</description>
  <maintainer email="noreply@example.com">student-sim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>car_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
